SELECT
    rc.id,
    rc.name AS room_category,
    rc.no_of_rooms AS total_rooms,

    COALESCE(b.booked_rooms, 0) AS booked_rooms,
    COALESCE(br.blocked_rooms, 0) AS blocked_rooms,

    GREATEST(
        rc.no_of_rooms
        - COALESCE(b.booked_rooms, 0)
        - COALESCE(br.blocked_rooms, 0),
        0
    ) AS available_rooms

FROM room_category_master rc

LEFT JOIN
(
    SELECT
        rbi.room_category_id,
        SUM(CAST(rbi.no_of_rooms AS UNSIGNED)) AS booked_rooms
    FROM room_booking_items rbi
    INNER JOIN room_bookings rb
        ON rb.id = rbi.booking_id
    WHERE
        rb.status IN ('Pending','Active')
        AND rb.checkin < '2026-07-20'
        AND rb.checkout > '2026-07-18'
        AND rbi.status IN ('Pending','Active')
    GROUP BY rbi.room_category_id
) b
ON b.room_category_id = rc.id

LEFT JOIN
(
    SELECT
        room_category_id,
        SUM(CAST(blocked_room AS UNSIGNED)) AS blocked_rooms
    FROM block_rooms
    WHERE
        from_date < '2026-07-20'
        AND to_date > '2026-07-18'
    GROUP BY room_category_id
) br
ON br.room_category_id = rc.id

WHERE rc.status='Active';